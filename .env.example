# Cisco Meraki Dashboard API key.
# Required for stdio and for HTTP when AUTH_MODE=env.
# The gateway Compose service does not set this. Do not add it to that
# service's environment or via env_file.
MERAKI_API_KEY=

# Default organization ID (optional — many tools accept an explicit organization_id).
# Gateway mode receives this per request as X-Meraki-Org-Id.
MERAKI_ORG_ID=

# Override the Meraki API base URL (optional, e.g. a regional shard)
MERAKI_BASE_URL=

# Safety: read-only mode is ON by default. Set to false to allow write operations.
READ_ONLY_MODE=true

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address when MCP_TRANSPORT=http. When unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty here.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (changeme, secret,
# placeholder, and the other public example values). Compose will not start
# when it is unset. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, skips X-Gateway-S2S, and binds 127.0.0.1 only.
# A known placeholder secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Meraki-Api-Key header on each /mcp request). The container image and Compose
# set gateway. Stdio ignores this and reads MERAKI_* from the environment.
# AUTH_MODE=env

# LOG_LEVEL=info
